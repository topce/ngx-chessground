{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": "../../out-tsc/lib",
		"declaration": true,
		"declarationMap": true,
		"inlineSources": true,
		"lib": ["dom", "es2018"]
	},
	"angularCompilerOptions": {
		"skipTemplateCodegen": true,
		"extendedDiagnostics": {
			"checks": {
				"nullishCoalescingNotNullable": "error",
				"optionalChainNotNullable": "error"
			}
		},
		"strictMetadataEmit": true,
		"enableResourceInlining": true
	},
	"exclude": []
}
