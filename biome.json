{
	"$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"./projects/**",
			"!!**/projects/ngx-chessground/assets/stockfish/stockfish.js",
			"!!**/assets/images/**",
			"!!**/move-list.component.html",
			"!!**/player-typeahead.component.html"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"noSvgWithoutTitle": "off",
				"useValidAnchor": "off",
				"noLabelWithoutControl": "off",
				"noInteractiveElementToNoninteractiveRole": "off",
				"useAriaPropsForRole": "off",
				"useFocusableInteractive": "off",
				"useSemanticElements": "off",
				"noNoninteractiveElementToInteractiveRole": "off"
			},
			"style": {
				"useImportType": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"css": {
		"linter": {
			"enabled": false
		}
	},
	"html": {
		"parser": {
			"interpolation": true
		}
	}
}
